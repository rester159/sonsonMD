{
 "source": "SonSon arcade ss.03e (6809 $C000-$FFFF). STATIC RE of the spawn tables, validated against live MAME md=02 capture (tools/spawn_cap_L0.txt, spawn_stage_*.txt).",
 "mechanism": {
  "dispatch": "sub_EFED($0638 wave-phase) -> sub_F065 select_pattern_ptr / sub_F019 bulk",
  "list_pointer_table": "0xF0C9 : 16 x u16 big-endian, one per (stage_group,phase_slot)",
  "index_formula": "ptr = [0xF0C9 + ((stage&0x30)>>1) + ((rng_parity)&6)]; stage=$0096",
  "stage_group": "(stage & 0x30) >> 1  -> byte offset {0,8,16,24} = group {0,1,2,3}",
  "phase_slot": "($0023 ^ $0024) & 6  (sub_F065) | ($0023 & 6) (sub_F019)  -> {0,2,4,6}",
  "list_format": "12 entries x (Y_byte, type_byte). Y -> [-8,u]; type -> [+3,u] (enemyMain $0828 variant).",
  "spawner": "sub_F080 spawn_obj_in_slot: worldX = scroll($0090) + 0x00F8 (right edge); active=0x80; rng flavor [+0xD]= (LFSR $78/$79) & 7",
  "spawn_x": "scroll + 0x00F8  (just off the right screen edge)",
  "pool": "$0828, 16 slots, stride 0x20",
  "onscreen_cap": "16 (sub_F080 stops when live count $00A6 == 0x10). Live md=02 peak observed = 10.",
  "spawn_rows_Y": [
   "0x28",
   "0x48",
   "0x68",
   "0x88",
   "0xA8",
   "0xC8"
  ],
  "spawn_rows_px": [
   40,
   72,
   104,
   136,
   168,
   200
  ]
 },
 "type_by_group": {
  "0": "type 0x00 (walker variant A)  -- stages 0x00-0x0F",
  "1": "type 0x01 (walker variant B)  -- stages 0x10-0x1F",
  "2": "MIX of 0x00 and 0x01          -- stages 0x20-0x2F (reached only at high/looped stages)",
  "3": "type 0x02 (walker variant C)  -- stages 0x30+ (deep loop only)"
 },
 "stage_progression": "$005A/$0096 increments per round (sub_A730 incb, cap 0x1C=28). $0067 is the LEVEL-GRAPHICS pin (decoupled from spawn stage).",
